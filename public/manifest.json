{
  "manifest_version": 3,
  "name": "ShotGridRodeoFx",
  "author": "kevin.zarshenas@gmail.com",
  "description": "Extension for improving Shotgun UI.",
  "homepage_url": "https://github.com/kekefreedog",
  "version": "3.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://shotgun.rodeofx.com/*",
        "https://rodeofx.shotgrid.autodesk.com/*"
      ],
      "run_at": "document_idle",
      "css": [
        "./style.css"
      ],
      "js": [
        "./contentScript/index.js"
      ]
    }
  ],
  "background": {
    "service_worker": "./background/background.js",
    "scripts": [
      "./background/background.js"
    ]
  },
  "action": {
    "default_popup": "./popup/index.html",
    "default_title": "Open the popup",
    "default_icon": "icon-72x72.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{8617accf-ad5a-46ff-a515-d746a82415c6}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "icons": {
    "72": "icon-72x72.png",
    "96": "icon-96x96.png",
    "128": "icon-128x128.png",
    "144": "icon-144x144.png",
    "152": "icon-152x152.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo-white.png",
        "logo-black.png",
        "logo-black-square.png",
        "logo-white-square.png"
      ],
      "matches": [
        "https://shotgun.rodeofx.com/*",
        "https://rodeofx.shotgrid.autodesk.com/*"
      ]
    }
  ]
}
